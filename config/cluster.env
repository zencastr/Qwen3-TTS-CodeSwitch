# Cluster / SLURM configuration for qwen3-tts-gen.
# Sourced by slurm/submit.sh (for sbatch flags) and by the .sbatch scripts (for
# runtime env). Every value can be overridden by exporting it before calling
# submit.sh, e.g.  PARTITION=debug TIME=00:20:00 slurm/submit.sh generate ...
#
# Defaults below match the DGX B300 cluster discovered at setup time.

# --- Scheduler (sbatch flags) ----------------------------------------------
PARTITION="${PARTITION:-gpu}"        # gpu (7d) | gpu_hp (unlimited) | debug (30m) | cpu
ACCOUNT="${ACCOUNT:-}"               # leave empty: this cluster uses no --account/--qos
GRES="${GRES:-gpu:1}"                # generic single GPU (cluster also accepts gpu:b300:N)
CPUS_PER_TASK="${CPUS_PER_TASK:-8}"
MEM="${MEM:-64G}"
TIME="${TIME:-04:00:00}"             # HH:MM:SS

# --- Paths ------------------------------------------------------------------
REPO_ROOT="${REPO_ROOT:-$HOME/qwen3_tts}"
# Model weights are big -> cache on scratch (not backed up, but fast + roomy).
QWEN3_TTS_CACHE="${QWEN3_TTS_CACHE:-/scratch/ick/qwen3_tts/cache}"

# --- Model / runtime defaults (consumed by qwen3_tts_gen) -------------------
QWEN3_TTS_MODEL="${QWEN3_TTS_MODEL:-1.7b-base}"   # alias or HF repo id
QWEN3_TTS_DTYPE="${QWEN3_TTS_DTYPE:-bfloat16}"
QWEN3_TTS_ATTN="${QWEN3_TTS_ATTN:-sdpa}"          # set flash_attention_2 only if installed
# Keep the cuDNN SDPA backend OFF on the B300 (sm_103) nodes: it has no valid
# execution plan and crashes inside the audio codec. 1 to re-enable elsewhere.
QWEN3_TTS_CUDNN_SDP="${QWEN3_TTS_CUDNN_SDP:-0}"
